! Parámetros del bloque 09: Van der Pol rígido.
!
! make run ejecuta este archivo dos veces con el MISMO paso h:
!   rigidez entrada.nml                                          -> Radau IIA
!   rigidez entrada.nml tableros/rk4.txt resultados/rk4.dat      -> RK4
&parametros
    tablero_archivo = 'tableros/radau_iia3.txt'
    mu      = 1000.0
    h       = 0.002
    t_final = 3000.0      ! casi dos periodos (T ~ (3 - 2 ln 2) mu ~ 1614)
    x0      = 2.0
    y0      = 0.0
    archivo_salida = 'resultados/radau.dat'
    paso_escritura = 100  ! 1,5 millones de pasos: se escribe uno de cada 100
/
