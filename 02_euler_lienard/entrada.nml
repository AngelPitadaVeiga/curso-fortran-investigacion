! Parámetros del bloque 02 (Euler explícito para Liénard / Van der Pol).
! Formato namelist: empieza con &nombre y termina con /
! Los comentarios empiezan con '!'. Las variables que no aparezcan
! conservan su valor por defecto (el que tienen en el programa).
&parametros
    mu      = 1.0        ! parámetro de Van der Pol
    h       = 0.01       ! tamaño de paso
    t_final = 30.0       ! instante final
    x0      = 0.5        ! condición inicial
    y0      = 0.0
    archivo_salida = 'resultados/euler.dat'
/
