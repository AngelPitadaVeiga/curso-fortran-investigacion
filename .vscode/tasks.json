{
    // Tareas del curso. Ctrl+Shift+B ejecuta la tarea por defecto:
    // compila y ejecuta el bloque del archivo que tengas abierto (con make si
    // el bloque tiene Makefile; si no, solo el archivo abierto).
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compilar y ejecutar bloque",
            "type": "shell",
            "windows": {
                "command": "powershell",
                "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File",
                         "${workspaceFolder}/.vscode/bloque.ps1", "${file}", "run"]
            },
            "linux": { "command": "bash", "args": ["${workspaceFolder}/.vscode/bloque.sh", "${file}", "run"] },
            "osx": { "command": "bash", "args": ["${workspaceFolder}/.vscode/bloque.sh", "${file}", "run"] },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Compilar bloque (debug)",
            "type": "shell",
            "windows": {
                "command": "powershell",
                "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File",
                         "${workspaceFolder}/.vscode/bloque.ps1", "${file}", "debug"]
            },
            "linux": { "command": "bash", "args": ["${workspaceFolder}/.vscode/bloque.sh", "${file}", "debug"] },
            "osx": { "command": "bash", "args": ["${workspaceFolder}/.vscode/bloque.sh", "${file}", "debug"] },
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Dibujar resultados del bloque (make plot)",
            "type": "shell",
            "windows": {
                "command": "powershell",
                "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File",
                         "${workspaceFolder}/.vscode/bloque.ps1", "${file}", "plot"]
            },
            "linux": { "command": "bash", "args": ["${workspaceFolder}/.vscode/bloque.sh", "${file}", "plot"] },
            "osx": { "command": "bash", "args": ["${workspaceFolder}/.vscode/bloque.sh", "${file}", "plot"] },
            "problemMatcher": []
        },
        {
            "label": "Limpiar bloque (make clean)",
            "type": "shell",
            "windows": {
                "command": "powershell",
                "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File",
                         "${workspaceFolder}/.vscode/bloque.ps1", "${file}", "clean"]
            },
            "linux": { "command": "bash", "args": ["${workspaceFolder}/.vscode/bloque.sh", "${file}", "clean"] },
            "osx": { "command": "bash", "args": ["${workspaceFolder}/.vscode/bloque.sh", "${file}", "clean"] },
            "problemMatcher": []
        },
        {
            // Compila y ejecuta solo el archivo abierto, aunque el bloque tenga Makefile.
            "label": "Compilar y ejecutar archivo suelto",
            "type": "shell",
            "command": "gfortran -Wall ${fileBasename} -o ${fileBasenameNoExtension}; ./${fileBasenameNoExtension}",
            "options": { "cwd": "${fileDirname}" },
            "group": "build",
            "problemMatcher": ["$gcc"]
        }
    ]
}
