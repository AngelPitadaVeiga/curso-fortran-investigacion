! La ménsula de estatico.nml, soltada desde su deformación estática, con el método
! implícito (Newmark): dos periodos (unos 155 cada uno), a unos 300 pasos por periodo.
&parametros
    archivo_malla = 'mensula.malla'
    carga = 1.0e-3
    metodo = 'implicito'
    dt = 0.5
    t_final = 320.0
    paso_escritura = 2
/
