! La viga de estatico.nml, soltada desde su deformación estática, con el método
! implícito (Newmark) y un paso grande: dos periodos, a unos 300 pasos por periodo.
&parametros
    lx = 10.0
    ly = 1.0
    nx = 80
    ny = 8
    e_young = 1.0
    nu = 0.3
    rho = 1.0
    carga = 1.0e-4
    metodo = 'implicito'
    dt = 2.0
    t_final = 1300.0
    paso_escritura = 5
/
