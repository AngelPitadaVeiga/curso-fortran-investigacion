! Ecuación de Fisher-KPP: u_t = d u_xx + r u (1 - u). Un frente que sale del
! extremo izquierdo y avanza con velocidad 2 sqrt(r d), unos 0.063.
&parametros
    longitud     = 1.0
    n_elementos  = 200
    d            = 0.001
    r            = 1.0
    dt           = 0.05
    t_final      = 10.0
    metodo       = 'implicito'
    condicion    = 'escalon'
    n_guardados  = 10
    archivo_salida = 'resultados/fisher.dat'
/
