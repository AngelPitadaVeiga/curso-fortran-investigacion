! Ecuación del calor, u_t = 0.1 u_xx, desde u(x, 0) = cos(pi x). Euler implícito.
! Solución exacta: u(x, t) = exp(-0.1 pi^2 t) cos(pi x).
&parametros
    longitud     = 1.0
    n_elementos  = 50
    d            = 0.1
    r            = 0.0
    dt           = 0.01
    t_final      = 1.0
    metodo       = 'implicito'
    condicion    = 'coseno'
    archivo_salida = 'resultados/calor.dat'
/
