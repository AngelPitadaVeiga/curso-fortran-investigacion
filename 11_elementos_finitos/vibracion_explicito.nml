! Lo mismo con el método explícito, con un paso por debajo del máximo estable
! (2 / omega_max = 0.0705). El paso es ocho veces más pequeño que el del implícito,
! así que solo se simula un periodo.
&parametros
    archivo_malla = 'mensula.malla'
    carga = 1.0e-3
    metodo = 'explicito'
    dt = 0.06
    t_final = 160.0
    paso_escritura = 10
/
