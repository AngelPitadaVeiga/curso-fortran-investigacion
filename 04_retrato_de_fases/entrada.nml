! Parámetros del bloque 04 (retratos de fases).
&parametros
    mus = 0.1, 1.0, 5.0          ! un panel por cada valor (hasta 10)
    tablero_archivo = '../03_runge_kutta_butcher/tableros/rk4.txt'
    h = 0.01
    t_transitorio = 100.0        ! se integra y se descarta (para llegar al ciclo)
    t_ciclo       = 20.0         ! tiempo que se dibuja del ciclo límite (> un periodo)
    t_trayectoria = 10.0         ! duración de cada trayectoria de la rejilla
    margen        = 1.6          ! la caja es el ciclo ampliado en este factor
    n_flechas     = 21           ! rejilla de flechas: n_flechas x n_flechas
    n_condiciones = 5            ! rejilla de condiciones iniciales: 5 x 5
    carpeta = 'resultados/'
/
