! Test de convergencia (bloque 03). Problema no rígido: Van der Pol con mu = 1.
! Para cada tablero se usan los pasos h_inicial, h_inicial/2, ..., (n_pasos_h valores).
&convergencia
    tableros(1) = 'tableros/euler_explicito.txt'
    tableros(2) = 'tableros/heun.txt'
    tableros(3) = 'tableros/rk4.txt'
    tableros(4) = 'tableros/euler_implicito.txt'
    tableros(5) = 'tableros/gauss_legendre2.txt'
    tableros(6) = 'tableros/radau_iia3.txt'
    tablero_referencia = 'tableros/rk4.txt'
    h_referencia = 1.0e-4      ! referencia: RK4 con paso muy pequeño
    mu      = 1.0
    t_final = 2.0
    x0      = 2.0
    y0      = 0.0
    h_inicial = 0.1
    n_pasos_h = 5
    error_minimo     = 1.0e-12  ! errores menores se consideran redondeo
    tolerancia_orden = 0.3      ! |orden observado - teórico| permitido
    tol_newton       = 1.0e-13
    max_iter_newton  = 50
    archivo_salida = 'resultados/convergencia.dat'
/
