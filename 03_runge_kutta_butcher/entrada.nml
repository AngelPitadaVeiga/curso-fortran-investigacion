! Parámetros del bloque 03 (Runge-Kutta general con tablero de Butcher).
! Con los mismos mu, h, t_final, x0, y0 que el bloque 02 y el tablero de
! Euler explícito, la salida es idéntica a la del bloque 02.
&parametros
    tablero_archivo = 'tableros/rk4.txt'
    mu      = 1.0
    h       = 0.01
    t_final = 30.0
    x0      = 0.5
    y0      = 0.0
    tol_newton      = 1.0e-10   ! solo para métodos implícitos
    max_iter_newton = 20
    prefijo_salida  = 'resultados/'   ! salida: resultados/<tablero>.dat
    paso_escritura  = 1               ! escribir uno de cada N pasos
/
